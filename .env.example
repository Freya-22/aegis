# Copy to .env and fill in. .env is git-ignored.

# Ollama backend (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=llama3.2:3b

# Splunk (docker-compose.yml reads these too)
SPLUNK_PASSWORD=change-me-min-8-chars
SPLUNK_HEC_URL=http://localhost:8088/services/collector/event
SPLUNK_HEC_TOKEN=00000000-0000-0000-0000-000000000000
